# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edumind?retryWrites=true&w=majority"

# Random secret used to sign session cookies: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional
# GEMINI_MODEL="gemini-2.5-flash"                 # chat + quiz model
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"   # 768-dim embeddings for Vector Search
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app" # used in certificate verification links
